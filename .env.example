# ─────────────────────────────────────────────────────────────
# IDRISIYA COUTURE — environment variables
# Copy to `.env.local` for local development.
# In Vercel: Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# The public address of the live site. No trailing slash.
#
# Used for: SEO canonical/Open Graph tags, sitemap.xml, robots.txt, and the
# product links included in pre-filled WhatsApp order messages.
#
# Must be prefixed NEXT_PUBLIC_ so the value is identical on the server and
# in the browser (otherwise WhatsApp product links would differ).
#
# If you leave this unset, the site falls back to the project's Vercel
# domain: https://idrisiya-couture.vercel.app
#
# Local development:
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production with a custom domain:
#   NEXT_PUBLIC_SITE_URL=https://idrisiyacouture.com

NEXT_PUBLIC_SITE_URL=
